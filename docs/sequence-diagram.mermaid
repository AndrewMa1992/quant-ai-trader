sequenceDiagram
    participant VF as FactorResearch.vue
    participant SF as useFactorStore
    participant AF as factorApi
    participant RF as routes_factors.py
    participant HS as HistoricalStore
    participant DB as SQLite DB

    VF->>VF: onMounted()
    VF->>SF: fetchFactors()
    SF->>AF: GET /api/v2/factors/factors
    AF->>RF: HTTP request
    RF->>HS: get_factors()
    HS->>DB: SELECT * FROM factor_definitions
    DB-->>HS: rows
    HS-->>RF: FactorDef[]
    RF-->>AF: {factors: [...], categories: {...}}
    AF-->>SF: update factors, categories
    SF-->>VF: reactive render

    VF->>SF: fetchCorrelation(factorNames)
    SF->>AF: GET /api/v2/factors/correlation?factor_names=...
    AF->>RF: HTTP request
    RF->>HS: get_factor_correlation(names)
    HS->>DB: SELECT * FROM factor_correlation WHERE factor_1 IN (...) AND factor_2 IN (...)
    DB-->>HS: rows
    HS-->>RF: matrix + redundant pairs
    RF-->>AF: {correlation_matrix: {...}, redundant_pairs: [...]}
    AF-->>SF: update correlationMatrix, redundantPairs
    SF-->>VF: heatmap render

    ---

    participant VD as Dashboard.vue
    participant PS as usePortfolioStore
    participant EE as executionApi
    participant RT as routes_trade.py
    participant PM as PortfolioManager

    VD->>VD: onMounted()
    par parallel fetch
        VD->>PS: fetchDashboard()
        PS->>EE: getDashboard() → GET /api/trade/dashboard
        EE->>RT: HTTP request
        RT->>PM: get_metrics() + compute sharpe/max_dd/wr
        PM-->>RT: metrics + value_history
        RT-->>EE: DashboardMetrics
        EE-->>PS: update dashboardMetrics, navHistory
    and
        VD->>PS: fetchPositions()
        PS->>EE: GET /api/trade/positions
        EE->>RT: HTTP request
        RT->>PM: positions + cash
        PM-->>RT: positions list
        RT-->>EE: {positions: [...], cash: ...}
        EE-->>PS: update positions
    end
    PS-->>VD: reactive render AccountSummary + NAV chart

    ---

    participant VB as BacktestAnalysis.vue
    participant RP as routes_portfolio_history.py

    VB->>VB: onMounted()
    VB->>PS: fetchPortfolioHistory()
    PS->>EE: GET /api/v2/analysis/portfolio-history
    EE->>RP: HTTP request
    RP->>HS: get_portfolio_snapshots(limit=1008)
    HS->>DB: SELECT * FROM portfolio_snapshots ORDER BY timestamp DESC LIMIT 1008
    DB-->>HS: rows
    HS-->>RP: PortfolioSnapshot[]
    RP-->>EE: {nav_history: [...], drawdown_history: [...], summary: {...}}
    EE-->>PS: update portfolioHistory

    VB->>PS: fetchYearlyReturns()
    PS->>EE: GET /api/v2/analysis/yearly-returns
    EE->>RP: HTTP request
    RP->>HS: get_yearly_returns()
    HS->>DB: SELECT strftime('%Y',timestamp) as year, (last/first-1) as ret FROM portfolio_snapshots GROUP BY year
    DB-->>HS: yearly aggregations
    HS-->>RP: YearlyReturn[]
    RP-->>EE: {yearly_returns: [...]}
    EE-->>PS: update yearlyReturns
    PS-->>VB: reactive render equity curve + metrics + yearly bar chart

    ---

    participant VR as RiskDashboard.vue
    participant RS as useRiskStore
    participant RA as riskApi
    participant RC as risk_v2_router
    participant RM as RiskManager

    VR->>VR: onMounted()
    par parallel fetch
        VR->>RS: fetchBreakerStatus()
        RS->>RA: GET /api/v2/risk/circuit_breaker
        RA->>RC: HTTP request
        RC->>RM: get_status()
        RM-->>RC: breaker state
        RC-->>RA: CircuitBreakerStatus
        RA-->>RS: update breaker fields
    and
        VR->>RS: fetchDrawdownHistory()
        RS->>RA: GET /api/v2/risk/drawdown-history
        RA->>RP: HTTP request
        RP->>HS: get_portfolio_snapshots(drawdown_from_peak)
        HS->>DB: SELECT timestamp, drawdown_from_peak FROM portfolio_snapshots ORDER BY timestamp
        DB-->>HS: rows
        HS-->>RP: drawdown timeline
        RP-->>RA: {drawdown_timeline: [...], max_drawdown, current_drawdown}
        RA-->>RS: update drawdownHistory
    end
    RS-->>VR: reactive render circuit breaker + drawdown chart + gauge
