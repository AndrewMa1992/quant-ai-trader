classDiagram
    direction TB

    class TrainRequest {
        +str model_type
        +list~str~ tickers
        +str start_date
        +str end_date
        +dict hyperparams
    }

    class TrainJob {
        +str job_id
        +str model_type
        +str status
        +float started_at
        +float completed_at
        +dict metrics
        +str error
        +str mlflow_run_id
        +int model_version
    }

    class PredictRequest {
        +str ticker
        +dict~str,float~ features
        +list~str~ model_types
    }

    class BatchPredictRequest {
        +list~str~ tickers
        +list~str~ model_types
    }

    class SignalResult {
        +str ticker
        +float signal
        +float confidence
        +str direction
        +dict~str,float~ components
    }

    class RiskCheckRequest {
        +str ticker
        +int quantity
        +float price
        +dict portfolio_state
        +float signal_strength
    }

    class RiskCheckResult {
        +bool passed
        +str reason
        +list~str~ warnings
        +dict~str,float~ sanitized_weights
    }

    class RiskLimits {
        +float MAX_POSITION_SIZE
        +float MAX_SINGLE_STOCK_EXPOSURE
        +float STOP_LOSS
        +float MAX_DRAWDOWN_PORTFOLIO
        +float DAILY_LOSS_LIMIT
        +float VAR_LIMIT
        +float CVAR_LIMIT
        +int COOLING_OFF_MINUTES
        +int MAX_RETRY_ATTEMPTS
        +get_limit(attr_name) float
        +get_all_position_limits() dict
    }

    class OrderRequest {
        +str ticker
        +str side
        +int quantity
        +str order_type
        +float limit_price
        +str algo
        +str account
    }

    class OrderResult {
        +str order_id
        +str ticker
        +str side
        +int quantity
        +float filled_price
        +float filled_qty
        +str status
        +str algo
        +float placed_at
        +float updated_at
        +dict raw_response
    }

    class CycleSummary {
        +int cycle
        +str timestamp
        +int tickers
        +int signals
        +int approved
        +int orders
        +float elapsed_seconds
    }

    class APIResponse {
        +bool success
        +str message
        +T data
        +str code
    }

    class HealthResponse {
        +str status
        +str version
        +float uptime_seconds
        +str database
        +str redis
    }

    class ErrorResponse {
        +bool success
        +str message
        +str code
        +dict details
        +int status_code
    }

    TrainRequest --> TrainJob : 创建
    PredictRequest --> SignalResult : 生成
    BatchPredictRequest --> SignalResult : 批量生成
    RiskCheckRequest --> RiskCheckResult : 校验
    RiskCheckResult --> RiskLimits : 引用阈值
    OrderRequest --> OrderResult : 执行
    APIResponse --> SignalResult : 包装
    APIResponse --> TrainJob : 包装
    APIResponse --> RiskCheckResult : 包装
    APIResponse --> OrderResult : 包装
    APIResponse --> CycleSummary : 包装
