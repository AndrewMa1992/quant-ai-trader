# ── Quant AI Trader v2 – .gitignore ──────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so
*.dylib

# Virtual environments
.venv/
venv/
env/
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Testing & Coverage
.coverage
.coverage.*
.coverage_html/
htmlcov/
.pytest_cache/
.cache/

# Type checkers
.mypy_cache/
.dmypy.json
.ruff_cache/

# Logs
logs/
*.log
scripts/_run_*_logged.ps1

# MLflow
mlruns/
mlartifacts/

# Data files (large)
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.joblib
*.pb
*.pth

# Model checkpoints
checkpoints/
*.ckpt
*.state_dict

# Certificates & Keys
*.pem
*.key
*.crt
*.cer
certs/

# Cache directories
cache/
__MACOSX/

# Docker
.dockerignore

# Archives
_v1_archive/

# WorkBuddy agent workspace
.workbuddy/

# Database files
*.db
*.db.bak

# PyTorch model weights
*.pt
*.zip

# Allow tracked ensemble checkpoints for Lightsail AutoCD sync
!data/models/
!data/models/*.pt
!data/models/*.joblib
!data/models/*.zip
!data/models/*.json
!data/models/*.meta.json
!data/models/*.zip.meta.json

# Allow tracked daily bars downloaded on Lightsail (Sydney) for GPU train
!data/daily/
!data/daily/*.parquet

# GitHub runner binaries
.github/runner-work/


# Temporary
tmp/
temp/
*.tmp
