# =============================================================================
# Quant AI Trader – Docker paper deploy defaults
# Copied to .env by scripts/docker_deploy.sh when .env is missing
# =============================================================================

QAT_PROJECT_ROOT=.
QAT_APP_NAME=quant-ai-trader
QAT_APP_VERSION=2.1.0
QAT_ENV=docker
QAT_DEBUG=false
QAT_LOG_LEVEL=INFO
QAT_LOG_DIR=./logs

QAT_USE_DOCKER=true
QAT_EXECUTION_MODE=paper
QAT_TRADING_SIMULATION_MODE=true
QAT_ENABLED_MARKETS=US,HK,SG,AU,NZ
QAT_MARKET_ROTATION=US,HK,SG,AU,NZ
QAT_TRADING_HOURS_ONLY=false
QAT_US_24H_TRADING=true
QAT_TRADING_INITIAL_CAPITAL=1700
QAT_TIGER_PAPER_TRADING=true
# Extracted from repo history / ops docs (paper sim):
QAT_TIGER_ID=20159337
QAT_TIGER_ACCOUNT=21837535188693626
QAT_TIGER_PRIVATE_KEY_PATH=./certs/tiger_private_key.pem
# QAT_TIGER_LICENSE=
# Live (promotion only): 20874631
QAT_TRAIN_DEVICE=cpu
QAT_API_KEY=dev-api-key-change-in-production
QAT_CORS_ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:3000

QAT_API_PORT=8001
QAT_DATA_PORT=8011
QAT_FACTOR_PORT=8012
QAT_MODEL_TRAIN_PORT=8013
QAT_MODEL_INFER_PORT=8014
QAT_RISK_PORT=8015
QAT_EXEC_PORT=8016
QAT_FRONTEND_PORT=5180
QAT_MLFLOW_PORT=5000

QAT_POSTGRES_USER=qat
QAT_POSTGRES_PASSWORD=qat_secret
QAT_POSTGRES_DB=quant_trader
QAT_POSTGRES_HOST=postgres
QAT_POSTGRES_PORT=5432
QAT_POSTGRES_URL=postgresql+asyncpg://qat:qat_secret@postgres:5432/quant_trader
QAT_POSTGRES_SYNC_URL=postgresql+psycopg2://qat:qat_secret@postgres:5432/quant_trader

QAT_REDIS_HOST=redis
QAT_REDIS_PORT=6379
QAT_REDIS_PASSWORD=redis_secret
QAT_REDIS_URL=redis://:redis_secret@redis:6379/0
QAT_REDIS_DB=0

QAT_MLFLOW_TRACKING_URI=http://mlflow:5000
QAT_MLFLOW_ARTIFACT_ROOT=./mlruns
