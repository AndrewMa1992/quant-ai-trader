# =============================================================================
# Quant AI Trader v2 — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# All variables use QAT_ prefix (matching pydantic-settings env_prefix)
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────
QAT_PROJECT_ROOT=.
QAT_APP_NAME=quant-ai-trader
QAT_APP_VERSION=2.0.0
QAT_ENV=development
QAT_DEBUG=true
QAT_LOG_LEVEL=INFO
QAT_LOG_DIR=./logs

# ── API Gateway ──────────────────────────────────────────────────────────
QAT_API_PORT=8001
QAT_API_HOST=0.0.0.0
QAT_API_KEY=CHANGE_ME
QAT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Microservice Ports ───────────────────────────────────────────────────
QAT_DATA_PORT=8011
QAT_FACTOR_PORT=8012
QAT_MODEL_TRAIN_PORT=8013
QAT_MODEL_INFER_PORT=8014
QAT_RISK_PORT=8015
QAT_EXEC_PORT=8016

# ── Database (SQLite for dev; PostgreSQL for production) ────────────────
QAT_POSTGRES_URL=sqlite:///data/quant.db
QAT_POSTGRES_SYNC_URL=sqlite:///data/quant.db
QAT_POSTGRES_USER=qat
QAT_POSTGRES_PASSWORD=CHANGE_ME
QAT_POSTGRES_DB=quant_trader
QAT_POSTGRES_HOST=localhost
QAT_POSTGRES_PORT=5432
QAT_POSTGRES_POOL_SIZE=20
QAT_POSTGRES_MAX_OVERFLOW=10
QAT_POSTGRES_POOL_TIMEOUT=30
QAT_POSTGRES_ECHO_SQL=false

# ── Redis ────────────────────────────────────────────────────────────────
QAT_REDIS_URL=redis://localhost:6379/0
QAT_REDIS_PASSWORD=CHANGE_ME
QAT_REDIS_HOST=localhost
QAT_REDIS_PORT=6379
QAT_REDIS_DB=0
QAT_REDIS_MAX_CONNECTIONS=50

# ── Tiger Broker API ─────────────────────────────────────────────────────
QAT_TIGER_ID=CHANGE_ME
QAT_TIGER_ACCOUNT=CHANGE_ME
QAT_TIGER_PRIVATE_KEY_PATH=./certs/tiger_private_key.pem
QAT_TIGER_CLIENT_VERSION=3.0.0
QAT_TIGER_LICENSE=CHANGE_ME

# ── External Data APIs ───────────────────────────────────────────────────
QAT_ALPHA_VANTAGE_KEY=CHANGE_ME
QAT_POLYGON_KEY=CHANGE_ME
QAT_WIND_API_KEY=CHANGE_ME

# ── MLflow ───────────────────────────────────────────────────────────────
QAT_MLFLOW_TRACKING_URI=http://localhost:5000
QAT_MLFLOW_PORT=5000
QAT_MLFLOW_ARTIFACT_ROOT=./mlruns

# ── Model Parameters ─────────────────────────────────────────────────────
QAT_MODEL_TRAIN_EPOCHS=100
QAT_MODEL_BATCH_SIZE=256
QAT_MODEL_LEARNING_RATE=0.001
QAT_MODEL_EARLY_STOPPING_ROUNDS=10
QAT_MODEL_ENSEMBLE_WEIGHTS_UPDATE_INTERVAL=86400

# ── Backtest ─────────────────────────────────────────────────────────────
QAT_BACKTEST_START_DATE=2020-01-01
QAT_BACKTEST_END_DATE=2024-12-31
QAT_BACKTEST_INITIAL_CAPITAL=100000000.0
QAT_BACKTEST_COMMISSION_BPS=5.0
QAT_BACKTEST_SLIPPAGE_BPS=2.0

# ── Execution (paper/sim by default) ─────────────────────────────────────
QAT_EXECUTION_MODE=paper
QAT_TRADING_SIMULATION_MODE=true
QAT_EXECUTION_MAX_SLIPPAGE_BPS=10.0
QAT_EXECUTION_ORDER_TIMEOUT_SECONDS=30
QAT_EXECUTION_RETRY_ATTEMPTS=3

# ── Training ─────────────────────────────────────────────────────────────
# Use cpu unless a CUDA GPU is available; trainers also auto-fallback
QAT_TRAIN_DEVICE=cpu

# ── Docker ───────────────────────────────────────────────────────────────
QAT_USE_DOCKER=false

# ── Slack Alerts ─────────────────────────────────────────────────────────
QAT_SLACK_BOT_TOKEN=CHANGE_ME
QAT_SLACK_ALERT_CHANNEL=#quant-alerts
QAT_SLACK_TRADE_CHANNEL=#quant-trades
