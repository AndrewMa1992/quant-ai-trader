# =============================================================================
# Quant AI Trader – Windows Server / Lightsail native paper deploy
# Copied to .env by scripts/windows_deploy.ps1 when .env is missing
# =============================================================================

QAT_PROJECT_ROOT=.
QAT_APP_NAME=quant-ai-trader
QAT_APP_VERSION=2.1.0
QAT_ENV=windows
QAT_DEBUG=false
QAT_LOG_LEVEL=INFO
QAT_LOG_DIR=./logs

QAT_USE_DOCKER=false
QAT_EXECUTION_MODE=paper
QAT_TRADING_SIMULATION_MODE=true
QAT_ENABLED_MARKETS=US,HK,SG,AU,NZ
QAT_MARKET_ROTATION=US,HK,SG,AU,NZ
QAT_TRADING_HOURS_ONLY=false
QAT_US_24H_TRADING=true
QAT_TRADING_INITIAL_CAPITAL=1700
QAT_TIGER_PAPER_TRADING=true
# Extracted from repo history / ops docs (paper sim):
# tiger_id from commit 1d061ee; paper acct from REPORT/audit; live acct documented separately
QAT_TIGER_ID=20159337
QAT_TIGER_ACCOUNT=21837535188693626
QAT_TIGER_PRIVATE_KEY_PATH=./certs/tiger_private_key.pem
QAT_TIGER_LICENSE=TBSG
QAT_TIGER_SANDBOX=false
# Paper trading uses production OpenAPI + paper account. Do not enable sandbox.
# Live account (do NOT enable unless promotion gates pass): 20874631
QAT_TRAIN_DEVICE=cpu
QAT_API_KEY=dev-api-key-change-in-production
QAT_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://3.106.139.233:5180,http://3.106.139.233:8001,http://localhost:8001

QAT_API_PORT=8001
QAT_DATA_PORT=8011
QAT_FACTOR_PORT=8012
QAT_MODEL_TRAIN_PORT=8013
QAT_MODEL_INFER_PORT=8014
QAT_RISK_PORT=8015
QAT_EXEC_PORT=8016
QAT_FRONTEND_PORT=5180

# SQLite — primary on Windows Lightsail (WAL optimized at runtime)
QAT_POSTGRES_URL=sqlite+aiosqlite:///data/quant_trader.db
QAT_POSTGRES_SYNC_URL=sqlite:///data/quant_trader.db

# Redis — install via scripts/windows_install_redis.ps1 -Start
QAT_REDIS_HOST=127.0.0.1
QAT_REDIS_PORT=6379
QAT_REDIS_PASSWORD=
QAT_REDIS_URL=redis://127.0.0.1:6379/0
QAT_REDIS_DB=0

QAT_MLFLOW_TRACKING_URI=
QAT_TRAIN_DEVICE=cpu
